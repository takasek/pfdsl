#!/bin/sh
# All changing policy is version-controlled in the executing checkout.
for entry in scripts/hooks/check-default-branch scripts/pre-commit-gates; do
  if [ ! -x "./$entry" ]; then
    echo "error: $entry is missing or not executable; update this checkout before committing." >&2
    exit 1
  fi
done
# Historical setup can downgrade the shared hook. Repair before checking HEAD.
node scripts/shared-hooks.mjs install || exit 1
./scripts/hooks/check-default-branch || exit 1
exec ./scripts/pre-commit-gates
