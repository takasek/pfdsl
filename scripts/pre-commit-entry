#!/bin/sh
# Compatibility with the shared v2 dispatcher. Keep this checkout's existing
# default-branch policy and gates; do not reinstall or downgrade shared hooks.
if [ ! -x ./scripts/hooks/pre-commit-shim ]; then
  echo "error: scripts/hooks/pre-commit-shim is missing or not executable; update this checkout before committing." >&2
  exit 1
fi
exec ./scripts/hooks/pre-commit-shim
