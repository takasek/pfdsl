#!/bin/sh
# pfdsl-pre-commit-shim-version: 2
# Stable dispatch contract: policy and gates belong to the executing checkout.
if [ -x ./scripts/pre-commit-entry ]; then
  exec ./scripts/pre-commit-entry
fi
echo "error: scripts/pre-commit-entry is missing or not executable; update this checkout before committing." >&2
exit 1
