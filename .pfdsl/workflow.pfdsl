[adrs, decisions] >> distill_local_skills -> [distribution_review_perspectives, distribution_review_skill, prose_mechanization_audit_skill, retro_pattern_sweep_skill, spec_stress_skill, vscode_ext_debug_skill]

[adrs, decisions] >> externalize_bindings -> [bindings_pfd_ops, bindings_pfd_retro, delegation_guard, main_branch_guard, pre_artifact_advisory, workflow_md]

spec_stress_skill >>? maintain_spec

retro_skill >>? discuss

retro_skill >>? distill_ops
retro_skill >>? externalize_bindings

[adrs, payoff_log] >> write_article -> article

proposals >> file_issues -> gh_issues

findings >>? file_issues

