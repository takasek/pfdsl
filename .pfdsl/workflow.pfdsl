roadmap_pfdsl >>? map_deps

toolchain >> map_transform_boundaries -> [runtime_pipeline_md, runtime_pipeline_pfdsl]

[adrs, decisions] >> map_workflow -> workflow_pfdsl

[gh_issues, roadmap_pfdsl, spec] >> develop -> pull_request

pull_request >> merge_pr -> [issue_updates, pr_diagrams, toolchain]

bindings_pfd_ops >>? develop
bindings_pfd_retro >>? develop
ops_skill_general >>? develop
ops_skill_l3 >>? develop
roadmap_md >>? develop
runtime_pipeline_pfdsl >>? develop

toolchain >>? develop
vscode_ext_debug_skill >>? develop
workflow_pfdsl >>? develop

delegation_guard >>? develop
implementer_agent >>? develop
main_branch_guard >>? develop
pre_artifact_advisory >>? develop
workflow_md >>? develop

issue_updates >>? file_issues





[plugin_dist, published_cli, published_libraries] >> update_readme -> readme

[distribution_review_perspectives, plugin_dist] >> review_distribution -> distribution_review_record

distribution_review_record >>? distill_local_skills
distribution_review_record >>? distill_ops
distribution_review_skill >>? review_distribution

bindings_pfd_retro >> sweep_retro_patterns -> retro_pattern_sweep_record

[bindings_pfd_ops, bindings_pfd_retro, delegation_guard, main_branch_guard, ops_skill_general, ops_skill_l3, pre_artifact_advisory, roadmap_md, workflow_md] >> sweep_prose_mechanization -> prose_mechanization_sweep_record

prose_mechanization_audit_skill >>? sweep_prose_mechanization
prose_mechanization_sweep_record >>? externalize_bindings
retro_pattern_sweep_record >>? externalize_bindings
retro_pattern_sweep_skill >>? sweep_retro_patterns

[distribution_review_record, prose_mechanization_sweep_record, retro_pattern_sweep_record, toolchain] >> decide_cli_release -> cli_release_request

[distribution_review_record, prose_mechanization_sweep_record, retro_pattern_sweep_record, toolchain] >> decide_libraries_release -> libraries_release_request

[distribution_review_record, prose_mechanization_sweep_record, retro_pattern_sweep_record, toolchain] >> decide_vscode_release -> vscode_release_request
