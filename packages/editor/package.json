{
	"name": "@pfdsl/editor",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./preview": {
			"types": "./dist/preview.d.ts",
			"import": "./dist/preview.js"
		}
	},
	"scripts": {
		"build": "tsup src/index.ts src/preview.ts --format esm --dts",
		"test": "vitest run --coverage",
		"coverage": "vitest run --coverage",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@pfdsl/core": "workspace:*",
		"@pfdsl/graphviz-exporter": "workspace:*",
		"@pfdsl/preview-engine": "workspace:*"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^1.6.0",
		"@types/node": "^20.0.0",
		"jsdom": "^24.0.0",
		"tsup": "^8.0.0",
		"vitest": "^1.6.0"
	}
}
