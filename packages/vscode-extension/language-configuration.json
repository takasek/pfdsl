{
	"comments": {
		"lineComment": "#"
	},
	"brackets": [["[", "]"]],
	"autoClosingPairs": [
		{ "open": "[", "close": "]" },
		{ "open": "\"", "close": "\"", "notIn": ["string"] }
	],
	"surroundingPairs": [["[", "]"], ["\"", "\""]],
	"wordPattern": {
		"pattern": "[\\p{L}\\p{N}_-]+",
		"flags": "u"
	}
}
