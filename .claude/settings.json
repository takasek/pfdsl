{
  "permissions": {
    "allow": [
      "Bash(make setup)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(git fetch origin *)",
      "Bash(git merge --ff-only origin/*)",
      "Bash(git -C * fetch origin *)",
      "Bash(git -C * merge --ff-only origin/*)",
      "mcp__github__pull_request_read",
      "mcp__github__issue_read",
      "mcp__github__list_*",
      "mcp__github__get_*",
      "mcp__github__search_*",
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm build *)",
      "Bash(pnpm biome *)",
      "Bash(pnpm -r *)",
      "Bash(pnpm -C *)",
      "Bash(pnpm --filter *)",
      "Bash(node packages/cli/dist/cli.js *)",
      "Bash(node scripts/*)",
      "Bash(pfdsl check *)",
      "Bash(command -v *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr create *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent-operation-guard.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node scripts/command-usage-guard.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node scripts/verification-tree-guard.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node scripts/closes-create-guard.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent-operation-guard.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node scripts/roadmap-publish-guard.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node scripts/generated-root-instructions-guard.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*github.*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent-operation-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/managed-issue-reminder-post-tool-use.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if ! node scripts/setup-completion.mjs check; then echo '[pfdsl] setup completion marker is missing or stale in this worktree - running make setup'; make setup; fi",
            "timeout": 300,
            "statusMessage": "pfdsl: checking setup completion (make setup when marker is absent)"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pfdsl@pfdsl": false
  }
}
