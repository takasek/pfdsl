{
  "permissions": {
    "allow": [
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm build *)",
      "Bash(pnpm biome *)",
      "Bash(pnpm -r *)",
      "Bash(pnpm -C *)",
      "Bash(pnpm --filter *)",
      "Bash(node packages/cli/dist/cli.js *)",
      "Bash(node scripts/*)",
      "Bash(pfdsl check *)",
      "Bash(command -v *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr create *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test \"${CLAUDE_PROJECT_DIR#/}\" != \"${CLAUDE_PROJECT_DIR}\" || exit 2; node \"${CLAUDE_PROJECT_DIR}/scripts/run-repo-hook.mjs\" scripts/delegation-guard.mjs || exit 2",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "test \"${CLAUDE_PROJECT_DIR#/}\" != \"${CLAUDE_PROJECT_DIR}\" || exit 2; node \"${CLAUDE_PROJECT_DIR}/scripts/run-repo-hook.mjs\" scripts/main-commit-guard.mjs || exit 2",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "test \"${CLAUDE_PROJECT_DIR#/}\" != \"${CLAUDE_PROJECT_DIR}\" || exit 2; node \"${CLAUDE_PROJECT_DIR}/scripts/run-repo-hook.mjs\" scripts/command-usage-guard.mjs || exit 2",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "test \"${CLAUDE_PROJECT_DIR#/}\" != \"${CLAUDE_PROJECT_DIR}\" || exit 2; node \"${CLAUDE_PROJECT_DIR}/scripts/run-repo-hook.mjs\" scripts/verification-tree-guard.mjs || exit 2",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "test \"${CLAUDE_PROJECT_DIR#/}\" != \"${CLAUDE_PROJECT_DIR}\" || exit 2; node \"${CLAUDE_PROJECT_DIR}/scripts/run-repo-hook.mjs\" scripts/closes-create-guard.mjs || exit 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "test \"${CLAUDE_PROJECT_DIR#/}\" != \"${CLAUDE_PROJECT_DIR}\" || exit 2; node \"${CLAUDE_PROJECT_DIR}/scripts/run-repo-hook.mjs\" scripts/worktree-write-guard.mjs || exit 2",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "test \"${CLAUDE_PROJECT_DIR#/}\" != \"${CLAUDE_PROJECT_DIR}\" || exit 2; node \"${CLAUDE_PROJECT_DIR}/scripts/run-repo-hook.mjs\" scripts/roadmap-publish-guard.mjs || exit 2",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "test \"${CLAUDE_PROJECT_DIR#/}\" != \"${CLAUDE_PROJECT_DIR}\" || exit 2; node \"${CLAUDE_PROJECT_DIR}/scripts/run-repo-hook.mjs\" scripts/generated-root-instructions-guard.mjs || exit 2",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test \"${CLAUDE_PROJECT_DIR#/}\" != \"${CLAUDE_PROJECT_DIR}\" || exit 2; node \"${CLAUDE_PROJECT_DIR}/scripts/run-repo-hook.mjs\" hooks/managed-issue-reminder-post-tool-use.mjs || exit 2",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test \"${CLAUDE_PROJECT_DIR#/}\" != \"${CLAUDE_PROJECT_DIR}\" || exit 2; node \"${CLAUDE_PROJECT_DIR}/scripts/run-repo-hook.mjs\" --setup || exit 2",
            "timeout": 300,
            "statusMessage": "pfdsl: checking setup completion (make setup when marker is absent)"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pfdsl@pfdsl": false
  }
}
